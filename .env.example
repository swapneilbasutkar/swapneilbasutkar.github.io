# Public base URL of the deployed site.
# Used for metadataBase, canonical URLs and the absolute Open Graph image URL.
# Falls back to http://localhost:3000 when unset, so local development needs nothing.
NEXT_PUBLIC_SITE_URL=https://example.com

# Sub-path the site is served from, when it is not at the domain root.
# GitHub Pages project site (https://user.github.io/portfolio) -> /portfolio
# User site, custom domain, or Vercel                          -> leave empty
# The GitHub Pages workflow sets this automatically from the repository name.
NEXT_PUBLIC_BASE_PATH=
